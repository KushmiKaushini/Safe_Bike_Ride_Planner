# =============================================================================
# Safe Bike Ride Planner — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env containing real secrets to version control.
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
# Option 1 (Docker): Run `docker compose up -d mongodb`
MONGODB_URI=mongodb://localhost:27017/safe-bike-planner
# Option 2 (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safe-bike-planner?retryWrites=true&w=majority

# Session Secret (generate a random 64-char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-this-to-a-random-64-char-hex-string

# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OpenWeatherMap API (Weather and 1-5 AQI Air Pollution)
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# IP Geolocation API (for automatic browser location fallback)
# Get key from: https://ipgeolocation.io/
GEOLOCATION_API_KEY=your-ipgeolocation-api-key

# Frontend Client URL (for CORS and CSRF validation)
CLIENT_URL=http://localhost:3000

# Internal API Key (optional proxy security)
API_KEY=change-this-to-a-random-string
